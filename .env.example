# Copy to .env and fill in. Never commit .env.

# Free key from https://aistudio.google.com → Get API key
NUXT_GEMINI_API_KEY=

# Optional: which Gemini model writes the copy
NUXT_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: "gemini" or "stub" (stub writes simple copy without AI).
# Leave empty to use Gemini when a key is set, otherwise the stub.
NUXT_LLM_PROVIDER=
